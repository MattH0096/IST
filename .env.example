# Copy to .env.local and fill in. Nothing here is read at build time.

# Where form submissions are delivered (contact, careers apply, subscribe).
#
# Option A — Resend email (recommended):
#   RESEND_API_KEY=re_...
#   LEAD_INBOX=you@yourcompany.com
#   RESEND_FROM=IST Website <onboarding@resend.dev>   # optional; verify domain in Resend for production
#
# Option B — webhook (Zapier/Make/custom):
#   LEAD_WEBHOOK_URL=https://hooks.example.com/...
#   LEAD_INBOX=you@yourcompany.com   # passed through in the JSON payload
#
# Unset in development: submissions are logged to the server console and the
# form reports success, so the flow can be exercised locally.
# Unset in production: submissions are rejected with a 503 rather than silently
# discarded. See lib/server/deliver.ts.
RESEND_API_KEY=
RESEND_FROM=
LEAD_INBOX=
LEAD_WEBHOOK_URL=

# Client CMS (/admin). Required to open the admin. Use 8+ characters.
# Example: ADMIN_PASSWORD=change-me-now
ADMIN_PASSWORD=
