# Copy to .env.local and fill in. Nothing here is read at build time.

# Where form submissions are delivered.
#
# {{TBD}} — no provider has been chosen. Any endpoint that accepts a JSON POST
# works: Resend, Postmark, a Zapier/Make hook, or an internal service. The
# payload is { kind, submittedAt, fields, inbox }.
#
# Unset in development: submissions are logged to the server console and the
# form reports success, so the flow can be exercised locally.
# Unset in production: submissions are rejected with a 503 rather than silently
# discarded. See lib/server/deliver.ts.
LEAD_WEBHOOK_URL=

# The destination address, passed through to the webhook. Never rendered, never
# present in markup or schema — §9.10 forbids an email address anywhere on the
# site.
LEAD_INBOX=
